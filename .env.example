# Local environment variables for cbl-reconciler.
HTTP_ADDR=:8100
GRPC_ADDR=:9100
METRICS_ADDR=:9300
PG_DSN=postgres://cbl:cbl@localhost:5432/recon?sslmode=disable
MIGRATIONS_DIR=./migrations
KAFKA_BROKERS=localhost:9092
RECON_CANONICAL_CONSUMER_GROUP=cbl-reconciler-canonical
RECON_PAYOUT_CONSUMER_GROUP=cbl-reconciler-payouts
# The periodic pass runs only when the three gRPC targets and the provider
# list are set; without them the service still consumes the topics.
RECON_CONNECTOR_ADDR=localhost:9050
RECON_PAYMENT_ADDR=localhost:9030
RECON_LEDGER_ADDR=localhost:9040
RECON_PROVIDERS=coingate
RECON_EXPORT_INTERVAL=5m
RECON_LOOKBACK=24h
RECON_PAGE_LIMIT=100
RECON_EXPORT_MAX_PAGES=100
RECON_REPAIR_GRACE=15m
RECON_LEDGER_PAGE_LIMIT=200
RECON_LEDGER_MAX_PAGES=10
